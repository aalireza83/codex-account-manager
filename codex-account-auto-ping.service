[Unit]
Description=Codex account Auto Ping worker (no WebUI)
After=network.target

[Service]
Type=simple
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/usr/bin/python3 %h/Projects/codex-account-manager/app.py auto-ping run
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
